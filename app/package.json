{
  "name": "brain-console",
  "version": "0.2.0",
  "private": true,
  "description": "The Brain Console: a local daemon that reconciles every flow project into one live snapshot, and later the UI over it.",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node daemon/src/main.ts",
    "test": "node --test 'daemon/test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
